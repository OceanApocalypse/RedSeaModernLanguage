<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<RootNamespace>OceanApocalypse.RSML.CLI</RootNamespace>

		<!-- Tool setup -->
		<PackageId>OceanApocalypse.RSML.CLI</PackageId>
		<Title>RSML CLI</Title>
		<Description>The official RSML CLI.</Description>
		<PackageLicenseExpression>GPL-3.0-only</PackageLicenseExpression>

		<!-- Hybrid tool -->
		<IsPackable>false</IsPackable>
		<PublishAot>true</PublishAot>
		<InvariantGlobalization>$(PublishAot)</InvariantGlobalization>
		<PackAsTool>true</PackAsTool>
		<ToolCommandName>rsml</ToolCommandName>
		<ToolPackageRuntimeIdentifiers>
			any;win-x64;win-x86;win-arm64;osx-x64;osx-arm64;linux-x64;linux-arm64;linux-arm
		</ToolPackageRuntimeIdentifiers>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="SixLabors.ImageSharp" />
		<PackageReference Include="Spectre.Console" />
		<PackageReference Include="System.CommandLine" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\RSML\RSML.csproj" />
	</ItemGroup>

	<ItemGroup>
		<None Include="InternalAssets\**\*">
			<Link>InternalAssets\%(RecursiveDir)%(Filename)%(Extension)</Link>
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</None>
	</ItemGroup>

</Project>