<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<RootNamespace>OceanApocalypse.RSML.Native</RootNamespace>
		<OutputType>Library</OutputType>

		<!-- Native Publishing -->
		<PublishAot>true</PublishAot>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<NativeLib>Shared</NativeLib>
		<InvariantGlobalization>true</InvariantGlobalization>
		<TieredCompilation>true</TieredCompilation>
		<PublishSingleFile>false</PublishSingleFile>
	</PropertyGroup>

	<PropertyGroup Label="NuGet Package Setup">
		<PackageId>OceanApocalypse.RSML.Native</PackageId>
		<Title>RSML Native ABI</Title>

		<Description>Native C interopability for RSML.</Description>
		<PackageTags>DSL;native;interop;c;cpp;c++;language;logic;logic-path;rsml;rsea;decision;oss</PackageTags>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\RSML\RSML.csproj" />
	</ItemGroup>

</Project>